{
  "name": "@chxchx/behavior-captcha",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["examples/next-app"],
  "description": "Self-hosted anti-abuse checks for React and Next.js App Router",
  "type": "module",
  "exports": {
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./shared": "./src/shared/index.ts",
    "./styles.css": "./src/client/styles.css"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo": "npm run dev --workspace examples/next-app"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
